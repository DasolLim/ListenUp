# ── Speech-to-text (AssemblyAI — single STT provider) ──────────────
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# "mock" (default) = free canned captions for development.
# "real" = live AssemblyAI transcription of your actual mic (uses credits).
TRANSCRIPTION_SERVICE=mock
# Speaker identification (Phase 3): "mock" (CI-safe pseudo-embeddings) or
# "real" (ECAPA-TDNN, local CPU, needs backend/requirements-ml.txt installed)
SPEAKER_ID_SERVICE=mock
# Translation: "mock" (free) or "real" (Google v3 via gcloud ADC, Redis-cached)
TRANSLATION_SERVICE=mock
# Cultural/slang layer: "mock" or "real" (OpenRouter; model via OPENROUTER_MODEL)
ENHANCED_TRANSLATION_SERVICE=mock
# Cultural-translation model (default openai/gpt-4o for slang accuracy;
# set openai/gpt-4o-mini for cheaper, slightly less nuanced runs)
# OPENROUTER_MODEL=openai/gpt-4o
# GenZ slang explainer (Phase 5): "mock" (free, KB-only) or "real" (RAG + OpenRouter)
GENZ_EXPLAINER_SERVICE=mock

# Text-to-speech. "browser" (default) costs nothing: voices are rendered by the
# user's own device via speechSynthesis, and no key is needed. "elevenlabs"
# enables higher-quality cloud voices AND consent-gated custom voice cloning.
TTS_SERVICE=browser
# Korean speech uses AssemblyAI's async model (streaming has no Korean model)
# ASSEMBLYAI_BATCH_MODEL=universal-2
# Slang KB text embedder: "hashing" (default, local, no download) or "real" (MiniLM)
# TEXT_EMBEDDER=hashing
# Optional: where the KB writes admin-added terms + the gap log (default services/genz/data)
# GENZ_DATA_DIR=

# ── Translation (Google Cloud Translation v3) ──────────────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Local dev: leave GOOGLE_APPLICATION_CREDENTIALS unset and use
# `gcloud auth application-default login` instead (org policy blocks SA keys).
# Only set this if you have a service-account JSON (e.g. at deploy time):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Translation enhanced/GenZ (OpenRouter) ─────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key
# Only needed when TTS_SERVICE=elevenlabs.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── Supabase (Postgres + pgvector + Auth + Storage) ────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Bypasses RLS. Used by exactly one caller — the Stripe webhook, which has no
# user session to act on behalf of — and restricted in code to the tables in
# SERVICE_ROLE_TABLES (backend/app/supa.py).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Frontend-exposed copy (Next.js) — publishable key, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ── Auth provider ──────────────────────────────────────────────────
# "supabase" (default) or "clerk". See MIGRATION_PLAN.md §2 — leave unset until
# the Clerk cutover runbook has been completed, since flipping it before
# migration 0004 is applied will fail every authenticated request.
AUTH_PROVIDER=supabase
# Only needed when AUTH_PROVIDER=clerk. Issuer is the Clerk Frontend API URL,
# e.g. https://your-app.clerk.accounts.dev — used to fetch JWKS and to check iss.
CLERK_ISSUER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Stripe (subscriptions) ─────────────────────────────────────────
# Test keys start sk_test_ / pk_test_. A sk_live_ key must never reach a dev
# machine, and sk_test_ must never reach production — they are separate accounts.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_from-stripe-listen-or-dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
# One recurring Price per sellable tier. The webhook maps the price id back to a
# tier, so these must match the live prices exactly — a mismatch makes a paying
# subscriber resolve to Basic and logs `subscription_tier_unresolved`.
STRIPE_PRICE_BASIC=price_your-7.99-monthly-price
STRIPE_PRICE_PRO=price_your-14.99-monthly-price
# Optional launch incentive: a Stripe coupon of 20% off, duration=once. Applied
# to Pro checkouts only. Leave unset and the discount is neither charged nor
# advertised anywhere in the UI.
STRIPE_COUPON_PRO_FIRST_MONTH=
# Where Stripe returns the user after checkout.
APP_BASE_URL=http://localhost:3000


# ── Redis (translation + slang cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Observability ──────────────────────────────────────────────────
# Sentry (leave empty to disable — SDKs are no-ops without a DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog (leave empty to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Backend ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Frontend → backend WebSocket/API base
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
