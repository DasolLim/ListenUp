# ── Speech-to-text (AssemblyAI — single STT provider) ──────────────
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# ── Translation (Google Cloud Translation v3) ──────────────────────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Translation enhanced/GenZ (OpenRouter) ─────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Supabase (Postgres + pgvector + Auth + Storage) ────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Frontend-exposed copies (Next.js) — publishable key, safe for the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ── Redis (translation + slang cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Observability ──────────────────────────────────────────────────
# Sentry (leave empty to disable — SDKs are no-ops without a DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# PostHog (leave empty to disable)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Backend ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
# Frontend → backend WebSocket/API base
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
