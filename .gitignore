# Env / secrets
.env
.env.local
.env.*.local
# Any .env variant — a timestamped backup or a .env.prod is still secrets, and
# the default rules above don't cover them.
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Logs
*.log
